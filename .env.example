# ========================================================
# BucaLeads - Configurações de Ambiente
# ========================================================

# Para utilizar o Cloudflare D1 como banco de dados compartilhado:
# 1. Altere USE_CLOUDFLARE_D1 para true
# 2. Preencha seu Account ID, D1 Database ID e API Token da Cloudflare
#
# Se USE_CLOUDFLARE_D1 for false, o sistema usará o banco local (backend/leads.db)

USE_CLOUDFLARE_D1=false
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_API_TOKEN=
